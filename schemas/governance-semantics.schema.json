{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uigdwunm/subagent-governance/schemas/governance-semantics.schema.json",
  "title": "Subagent Governance current-only v9 semantics",
  "$defs": {
    "nonempty_text": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": ".*\\S.*"},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": ".*\\S.*"},
    "nullable_short_text": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/short_text"}]},
    "timestamp": {"type": "integer", "minimum": 0},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task_ref": {"type": "string", "pattern": "^(?:[a-f0-9]{12}|[a-f0-9]{20})$"},
    "profile": {"type": "string", "enum": ["standard", "strict"]},
    "phase": {"type": "string", "enum": ["prepared", "claimed", "bound", "terminal", "closed", "reconcile"]},
    "reasoning_effort": {"type": ["string", "null"], "enum": [null, "low", "medium", "high", "xhigh", "max", "ultra"]},
    "fork_turns": {"type": "string", "pattern": "^(?:none|all|[1-9][0-9]*)$", "maxLength": 12},
    "text_list": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/short_text"}},
    "context_path_list": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\S$"}
    },
    "verified_baseline": {
      "type": "object", "required": ["kind", "revision"],
      "properties": {
        "kind": {"type": "string", "enum": ["working_tree", "git_commit"]},
        "revision": {"type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
      },
      "additionalProperties": false
    },
    "verified_path_declaration": {
      "type": "object", "required": ["path", "type"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "type": {"type": "string", "enum": ["file", "directory"]}
      },
      "additionalProperties": false
    },
    "verified_context": {
      "type": "object", "required": ["mode", "workspace_root", "baseline", "required_paths"],
      "properties": {
        "mode": {"const": "declared"},
        "workspace_root": {"type": "string", "minLength": 1, "maxLength": 4000},
        "baseline": {"$ref": "#/$defs/verified_baseline"},
        "required_paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/verified_path_declaration"}}
      },
      "additionalProperties": false
    },
    "contract_context_input": {
      "type": "object",
      "properties": {
        "summary": {"type": "string", "maxLength": 8192},
        "paths": {"$ref": "#/$defs/context_path_list"},
        "verified": {"$ref": "#/$defs/verified_context"}
      },
      "additionalProperties": false
    },
    "contract_context": {
      "type": "object", "required": ["summary", "paths", "verified"],
      "properties": {
        "summary": {"type": "string", "maxLength": 8192},
        "paths": {"$ref": "#/$defs/context_path_list"},
        "verified": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/verified_context"}]}
      },
      "additionalProperties": false
    },
    "spawn_config_input": {
      "type": "object",
      "properties": {
        "fork_turns": {"$ref": "#/$defs/fork_turns"},
        "model": {"$ref": "#/$defs/nullable_short_text"},
        "reasoning_effort": {"$ref": "#/$defs/reasoning_effort"}
      },
      "additionalProperties": false
    },
    "spawn_config": {
      "type": "object", "required": ["fork_turns", "model", "reasoning_effort"],
      "properties": {
        "fork_turns": {"$ref": "#/$defs/fork_turns"},
        "model": {"$ref": "#/$defs/nullable_short_text"},
        "reasoning_effort": {"$ref": "#/$defs/reasoning_effort"}
      },
      "additionalProperties": false
    },
    "task_contract_input": {
      "type": "object", "required": ["objective", "scope", "completion"],
      "properties": {
        "profile": {"$ref": "#/$defs/profile"},
        "objective": {"$ref": "#/$defs/nonempty_text"},
        "scope": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/short_text"}},
        "forbidden_scope": {"$ref": "#/$defs/text_list"},
        "completion": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/short_text"}},
        "evidence": {"$ref": "#/$defs/text_list"},
        "context": {"$ref": "#/$defs/contract_context_input"},
        "spawn": {"$ref": "#/$defs/spawn_config_input"}
      },
      "allOf": [{
        "if": {"required": ["profile"], "properties": {"profile": {"const": "strict"}}},
        "then": {
          "required": ["forbidden_scope", "evidence"],
          "properties": {
            "forbidden_scope": {"type": "array", "minItems": 1},
            "evidence": {"type": "array", "minItems": 1}
          }
        }
      }],
      "additionalProperties": false
    },
    "task_contract": {
      "type": "object", "required": ["profile", "objective", "scope", "forbidden_scope", "completion", "evidence", "context", "spawn"],
      "properties": {
        "profile": {"$ref": "#/$defs/profile"},
        "objective": {"$ref": "#/$defs/nonempty_text"},
        "scope": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/short_text"}},
        "forbidden_scope": {"$ref": "#/$defs/text_list"},
        "completion": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/short_text"}},
        "evidence": {"$ref": "#/$defs/text_list"},
        "context": {"$ref": "#/$defs/contract_context"},
        "spawn": {"$ref": "#/$defs/spawn_config"}
      },
      "allOf": [{
        "if": {"properties": {"profile": {"const": "strict"}}},
        "then": {
          "properties": {
            "forbidden_scope": {"type": "array", "minItems": 1},
            "evidence": {"type": "array", "minItems": 1}
          }
        }
      }],
      "additionalProperties": false
    },
    "context_verification_path": {
      "oneOf": [
        {
          "type": "object", "required": ["path", "type", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1000}, "type": {"const": "file"}, "sha256": {"$ref": "#/$defs/digest"}},
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["path", "type", "object_id"],
          "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1000}, "type": {"type": "string", "enum": ["file", "directory"]}, "object_id": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}},
          "additionalProperties": false
        }
      ]
    },
    "context_verification": {
      "type": "object", "required": ["mode", "workspace_root", "baseline", "required_paths"],
      "properties": {
        "mode": {"const": "declared"},
        "workspace_root": {"type": "string", "minLength": 1, "maxLength": 4000},
        "baseline": {"$ref": "#/$defs/verified_baseline"},
        "required_paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/context_verification_path"}}
      },
      "additionalProperties": false
    },
    "expected_native_parameters": {
      "type": "object", "required": ["task_name", "message", "fork_turns", "model", "reasoning_effort"],
      "properties": {
        "task_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 65536},
        "fork_turns": {"$ref": "#/$defs/fork_turns"},
        "model": {"$ref": "#/$defs/nullable_short_text"},
        "reasoning_effort": {"$ref": "#/$defs/reasoning_effort"}
      },
      "additionalProperties": false
    },
    "prepared_capability": {
      "type": "object", "required": ["contract", "context_verification", "expected_native_parameters", "spawn_digest", "expires_at"],
      "properties": {
        "contract": {"$ref": "#/$defs/task_contract"},
        "context_verification": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/context_verification"}]},
        "expected_native_parameters": {"$ref": "#/$defs/expected_native_parameters"},
        "spawn_digest": {"$ref": "#/$defs/digest"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "contract_summary": {
      "type": "object", "required": ["profile", "objective"],
      "properties": {"profile": {"$ref": "#/$defs/profile"}, "objective": {"$ref": "#/$defs/nonempty_text"}},
      "additionalProperties": false
    },
    "reconcile_fact": {
      "type": "object", "required": ["code", "observed_at"],
      "properties": {
        "code": {"type": "string", "enum": ["dispatch_target_conflict", "dispatch_identity_mismatch", "dispatch_result_unknown", "delivery_unknown", "platform_observation_unknown", "interrupt_unknown", "terminal_status_conflict"]},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "terminal_fact": {
      "type": "object", "required": ["source", "status", "observed_at"],
      "properties": {
        "source": {"type": "string", "enum": ["platform", "notification", "interrupt"]},
        "status": {"type": "string", "enum": ["completed", "failed", "stopped", "interrupted", "inactive"]},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "platform_observation": {
      "type": "object", "required": ["status", "observed_at"],
      "properties": {
        "status": {"type": "string", "enum": ["running", "completed", "stopped", "interrupted", "error"]},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "interrupt_fact": {
      "type": "object", "required": ["result", "observed_at"],
      "properties": {
        "result": {"type": "string", "enum": ["failed", "inactive"]},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "prepared_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "prepared"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "prepared"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "prepared": {"$ref": "#/$defs/prepared_capability"}},
      "additionalProperties": false
    },
    "claimed_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "prepared", "claimed_tool_use_id", "claimed_at"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "claimed"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "prepared": {"$ref": "#/$defs/prepared_capability"}, "claimed_tool_use_id": {"$ref": "#/$defs/short_text"}, "claimed_at": {"$ref": "#/$defs/timestamp"}},
      "additionalProperties": false
    },
    "bound_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "target", "bound_at"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "bound"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "target": {"$ref": "#/$defs/short_text"}, "bound_at": {"$ref": "#/$defs/timestamp"}, "platform_observation": {"$ref": "#/$defs/platform_observation"}, "interrupt_fact": {"$ref": "#/$defs/interrupt_fact"}},
      "additionalProperties": false
    },
    "terminal_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "target", "bound_at", "terminal_fact"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "terminal"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "target": {"$ref": "#/$defs/short_text"}, "bound_at": {"$ref": "#/$defs/timestamp"}, "terminal_fact": {"$ref": "#/$defs/terminal_fact"}, "platform_observation": {"$ref": "#/$defs/platform_observation"}, "interrupt_fact": {"$ref": "#/$defs/interrupt_fact"}},
      "additionalProperties": false
    },
    "closed_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "close_reason", "closed_at"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "closed"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "target": {"$ref": "#/$defs/short_text"}, "bound_at": {"$ref": "#/$defs/timestamp"}, "terminal_fact": {"$ref": "#/$defs/terminal_fact"}, "platform_observation": {"$ref": "#/$defs/platform_observation"}, "interrupt_fact": {"$ref": "#/$defs/interrupt_fact"}, "close_reason": {"$ref": "#/$defs/short_text"}, "closed_at": {"$ref": "#/$defs/timestamp"}},
      "additionalProperties": false
    },
    "reconcile_task": {
      "type": "object", "required": ["task_ref", "phase", "contract_digest", "contract_summary", "created_at", "updated_at", "reconcile"],
      "properties": {"task_ref": {"$ref": "#/$defs/task_ref"}, "phase": {"const": "reconcile"}, "contract_digest": {"$ref": "#/$defs/digest"}, "contract_summary": {"$ref": "#/$defs/contract_summary"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "target": {"$ref": "#/$defs/short_text"}, "bound_at": {"$ref": "#/$defs/timestamp"}, "terminal_fact": {"$ref": "#/$defs/terminal_fact"}, "platform_observation": {"$ref": "#/$defs/platform_observation"}, "interrupt_fact": {"$ref": "#/$defs/interrupt_fact"}, "reconcile": {"$ref": "#/$defs/reconcile_fact"}},
      "additionalProperties": false
    },
    "task_record": {"oneOf": [{"$ref": "#/$defs/prepared_task"}, {"$ref": "#/$defs/claimed_task"}, {"$ref": "#/$defs/bound_task"}, {"$ref": "#/$defs/terminal_task"}, {"$ref": "#/$defs/closed_task"}, {"$ref": "#/$defs/reconcile_task"}]},
    "session_ledger": {
      "type": "object", "required": ["state_format_version", "session_id", "tasks"],
      "properties": {
        "state_format_version": {"const": 9},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "tasks": {"type": "object", "maxProperties": 512, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 256}, "additionalProperties": {"$ref": "#/$defs/task_record"}}
      },
      "additionalProperties": false
    }
  },
  "x-semantics": {
    "state_format_version": 9,
    "state_storage_namespace": "state-v9",
    "task_contract_wire_version": 2,
    "task_contract_fields": ["profile", "objective", "scope", "forbidden_scope", "completion", "evidence", "context", "spawn"],
    "task_contract_required_input_fields": ["objective", "scope", "completion"],
    "profiles": ["standard", "strict"],
    "phases": ["prepared", "claimed", "bound", "terminal", "closed", "reconcile"],
    "task_ref_lengths": [12, 20],
    "prepared_expiry_seconds": 300,
    "closed_task_retention": 64,
    "platform_observation_statuses": ["running", "completed", "stopped", "interrupted", "error", "unknown"],
    "platform_terminal_statuses": ["completed", "stopped", "interrupted"],
    "terminal_notification_statuses": ["completed", "stopped", "interrupted"],
    "call_results": ["success", "failed", "unknown"],
    "interrupt_results": ["failed", "inactive", "unknown"],
    "max_hook_input_bytes": 2097152,
    "new_task_soft_limit_bytes": 3145728,
    "max_state_bytes": 4194304
  }
}
