{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subagent-governance/governance-semantics",
  "title": "Subagent Governance machine semantics",
  "$defs": {
    "requested_mode": {
      "type": "string",
      "enum": ["auto", "light", "standard", "strict"]
    },
    "resolved_mode": {
      "type": "string",
      "enum": ["light", "standard", "strict"]
    },
    "resolution_reason": {
      "type": "string",
      "enum": ["explicit_request", "auto_light", "auto_standard", "auto_strict"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "reasoning_effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "context_strategy": {
      "type": "string",
      "enum": ["isolated", "limited", "full"]
    },
    "context_turns": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 100
    },
    "operation_type": {
      "type": "string",
      "enum": ["normal_message", "platform_recovery", "business_resume"]
    },
    "dispatch_state": {
      "type": "string",
      "enum": ["prepared", "claimed", "acknowledged", "rejected", "indeterminate"]
    },
    "observation_source": {
      "type": "string",
      "enum": [
        "list_agents", "terminal_notification", "session"
      ]
    },
    "observed_state": {
      "type": "string",
      "enum": ["not_observed", "active", "terminal", "absent_at_check", "error", "unknown"]
    },
    "execution_status": {
      "type": "string",
      "enum": ["not_started", "running", "stopped", "interrupted"]
    },
    "spawn_observation": {
      "type": "string",
      "enum": ["success", "failed", "unknown"]
    },
    "identity_status": {
      "type": "string",
      "enum": ["unconfirmed", "confirmed"]
    },
    "platform_observation": {
      "type": "string",
      "enum": ["normal", "error", "unknown"]
    },
    "parent_action": {
      "type": "string",
      "enum": [
        "wait",
        "reconcile",
        "retry_spawn",
        "recover",
        "decide_disposition",
        "ask_user"
      ]
    },
    "parent_disposition": {
      "type": "string",
      "enum": ["close_task"]
    },
    "call_observation": {
      "type": "string",
      "enum": ["success", "failed", "unknown"]
    },
    "pending_action_phase": {
      "type": "string",
      "enum": ["prepared", "claimed"]
    },
    "pending_operation_type": {
      "type": "string",
      "enum": [
        "normal_message", "platform_recovery", "business_resume", "interrupt"
      ]
    },
    "lifecycle_operation_type": {
      "type": "string",
      "enum": ["platform_recovery", "business_resume", "interrupt"]
    },
    "semantic_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "task_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^sg_(light|standard|strict)_([a-z0-9]+(?:_[a-z0-9]+)*)_t_([a-f0-9]{12}(?:[a-f0-9]{4}){0,5})$",
      "x-task-ref-lengths": [12, 16, 20, 24, 28, 32]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "business_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "nullable_business_text": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "short_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S"
    },
    "nullable_short_text": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S"
    },
    "model": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "nullable_reasoning_effort": {
      "anyOf": [
        {"$ref": "#/$defs/reasoning_effort"},
        {"type": "null"}
      ]
    },
    "text_list": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      }
    },
    "task_features": {
      "type": "object",
      "required": [
        "risk",
        "read_only",
        "writes_files",
        "destructive",
        "production",
        "concurrent_write"
      ],
      "properties": {
        "risk": {"$ref": "#/$defs/risk"},
        "read_only": {"type": "boolean"},
        "writes_files": {"type": "boolean"},
        "destructive": {"type": "boolean"},
        "production": {"type": "boolean"},
        "concurrent_write": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "context_manifest_mode": {
      "type": "string",
      "enum": ["none", "declared"]
    },
    "context_baseline_kind": {
      "type": "string",
      "enum": ["working_tree", "git_commit"]
    },
    "context_path_type": {
      "type": "string",
      "enum": ["file", "directory"]
    },
    "context_baseline": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "revision"],
          "properties": {
            "kind": {"const": "working_tree"},
            "revision": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "revision"],
          "properties": {
            "kind": {"const": "git_commit"},
            "revision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "context_required_path": {
      "type": "object",
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "type": {"$ref": "#/$defs/context_path_type"}
      },
      "additionalProperties": false
    },
    "context_manifest": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {"const": "none"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "workspace_root", "baseline", "required_paths"],
          "properties": {
            "mode": {"const": "declared"},
            "workspace_root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "baseline": {"$ref": "#/$defs/context_baseline"},
            "required_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/context_required_path"}
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "baseline": {
                    "properties": {"kind": {"const": "working_tree"}}
                  }
                }
              },
              "then": {
                "properties": {
                  "required_paths": {
                    "items": {
                      "properties": {"type": {"const": "file"}}
                    }
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "work_item_lifecycle": {
      "type": "string",
      "enum": ["open", "tombstoned"]
    },
    "task_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{12}(?:[a-f0-9]{4}){0,5}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_timestamp": {
      "anyOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "context_verification": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "workspace_root", "baseline", "required_paths"],
          "properties": {
            "mode": {"const": "declared"},
            "workspace_root": {"type": "string", "minLength": 1},
            "baseline": {"$ref": "#/$defs/context_baseline"},
            "required_paths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "task_contract": {
      "type": "object",
      "required": [
        "semantic_name", "requested_mode", "resolved_mode", "resolution_reason",
        "task_features", "objective", "background", "work_scope", "forbidden_scope",
        "completion_conditions", "evidence_requirements", "relevant_files",
        "context_manifest", "current_state", "model", "reasoning_effort",
        "context_strategy", "context_turns", "context_reason"
      ],
      "properties": {
        "semantic_name": {"$ref": "#/$defs/semantic_name"},
        "requested_mode": {"$ref": "#/$defs/requested_mode"},
        "resolved_mode": {"$ref": "#/$defs/resolved_mode"},
        "resolution_reason": {"$ref": "#/$defs/resolution_reason"},
        "task_features": {"$ref": "#/$defs/task_features"},
        "objective": {"$ref": "#/$defs/business_text"},
        "background": {"$ref": "#/$defs/business_text"},
        "work_scope": {"$ref": "#/$defs/text_list", "minItems": 1},
        "forbidden_scope": {"$ref": "#/$defs/text_list"},
        "completion_conditions": {"$ref": "#/$defs/text_list", "minItems": 1},
        "evidence_requirements": {"$ref": "#/$defs/text_list"},
        "relevant_files": {"$ref": "#/$defs/text_list"},
        "context_manifest": {"$ref": "#/$defs/context_manifest"},
        "current_state": {"$ref": "#/$defs/nullable_business_text"},
        "model": {"$ref": "#/$defs/model"},
        "reasoning_effort": {"$ref": "#/$defs/nullable_reasoning_effort"},
        "context_strategy": {"$ref": "#/$defs/context_strategy"},
        "context_turns": {"$ref": "#/$defs/context_turns"},
        "context_reason": {"$ref": "#/$defs/nullable_business_text"}
      },
      "allOf": [
        {"if": {"properties": {"requested_mode": {"const": "light"}}}, "then": {"properties": {"resolved_mode": {"const": "light"}, "resolution_reason": {"const": "explicit_request"}}}},
        {"if": {"properties": {"requested_mode": {"const": "standard"}}}, "then": {"properties": {"resolved_mode": {"const": "standard"}, "resolution_reason": {"const": "explicit_request"}}}},
        {"if": {"properties": {"requested_mode": {"const": "strict"}}}, "then": {"properties": {"resolved_mode": {"const": "strict"}, "resolution_reason": {"const": "explicit_request"}}}},
        {"if": {"properties": {"resolved_mode": {"const": "standard"}}}, "then": {"properties": {"evidence_requirements": {"minItems": 1}}}},
        {"if": {"properties": {"resolved_mode": {"const": "strict"}}}, "then": {"properties": {"forbidden_scope": {"minItems": 1}, "evidence_requirements": {"minItems": 1}}}},
        {"if": {"properties": {"context_strategy": {"const": "isolated"}}}, "then": {"properties": {"context_turns": {"type": "null"}}}},
        {"if": {"properties": {"context_strategy": {"const": "limited"}}}, "then": {"properties": {"context_turns": {"type": "integer", "minimum": 1, "maximum": 100}, "context_reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"context_strategy": {"const": "full"}}}, "then": {"properties": {"context_turns": {"type": "null"}, "context_reason": {"type": "string", "minLength": 1}}}}
      ],
      "additionalProperties": false
    },
    "initial_rollback_marker": {
      "type": "object",
      "required": ["status", "task_ref", "observed_at", "error"],
      "properties": {
        "status": {"const": "rollback_incomplete"},
        "task_ref": {"$ref": "#/$defs/task_ref"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "error": {"$ref": "#/$defs/short_text"}
      },
      "additionalProperties": false
    },
    "health_record": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "degraded", "unavailable"]},
        "initial_preparation_rollback": {"$ref": "#/$defs/initial_rollback_marker"}
      },
      "additionalProperties": false
    },
    "group_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "group_member": {
      "type": "object",
      "required": ["task_id", "required"],
      "properties": {"task_id": {"$ref": "#/$defs/task_id"}, "required": {"type": "boolean"}},
      "additionalProperties": false
    },
    "group_record": {
      "type": "object",
      "required": ["group_id", "objective_summary", "members"],
      "properties": {
        "group_id": {"$ref": "#/$defs/group_id"},
        "objective_summary": {"$ref": "#/$defs/short_text"},
        "members": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/group_member"}}
      },
      "additionalProperties": false
    },
    "work_item": {
      "type": "object",
      "required": [
        "lifecycle",
        "current_attempt"
      ],
      "properties": {
        "objective_summary": false,
        "lifecycle": {"$ref": "#/$defs/work_item_lifecycle"},
        "current_attempt": {"$ref": "#/$defs/attempt"},
        "created_at": false,
        "updated_at": false,
        "attempt_count": false,
        "last_disposition": false,
        "last_parent_disposition": false,
        "action_required": false
      },
      "additionalProperties": false
    },
    "contract_summary": {
      "type": "object",
      "required": ["objective", "model"],
      "properties": {
        "objective": {"$ref": "#/$defs/short_text"},
        "completion_conditions": false,
        "model": {"$ref": "#/$defs/model"}
      },
      "additionalProperties": false
    },
    "dispatch_record": {
      "type": "object",
      "required": [
        "dispatch_state", "tool_use_id", "dispatch_target"
      ],
      "properties": {
        "dispatch_state": {"$ref": "#/$defs/dispatch_state"},
        "tool_use_id": {"type": ["string", "null"], "minLength": 1},
        "dispatch_target": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "observation_record": {
      "type": "object",
      "required": [
        "source", "observed_state", "observed_at",
        "terminal_status"
      ],
      "properties": {
        "subject": false,
        "source": {
          "anyOf": [{"$ref": "#/$defs/observation_source"}, {"type": "null"}]
        },
        "observed_state": {"$ref": "#/$defs/observed_state"},
        "observed_at": {"$ref": "#/$defs/nullable_timestamp"},
        "terminal_status": {
          "type": ["string", "null"],
          "enum": [null, "completed", "stopped", "interrupted"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"observed_state": {"const": "terminal"}}},
          "then": {"properties": {"terminal_status": {"type": "string"}}}
        }
      ]
    },
    "closure_record": {
      "type": "object",
      "required": [
        "reason", "closed_at", "parent_action"
      ],
      "properties": {
        "closure_state": false,
        "reason": {"$ref": "#/$defs/nullable_short_text"},
        "closed_at": {"$ref": "#/$defs/nullable_timestamp"},
        "parent_action": {
          "anyOf": [{"$ref": "#/$defs/parent_action"}, {"type": "null"}]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "reason": {"type": "null"},
            "closed_at": {"type": "null"}
          }
        },
        {
          "properties": {
            "reason": {"$ref": "#/$defs/short_text"},
            "closed_at": {"$ref": "#/$defs/timestamp"}
          }
        }
      ]
    },
    "execution_record": {
      "type": "object",
      "required": [
        "task_ref", "task_name",
        "resolved_mode",
        "contract_summary", "contract_digest",
        "dispatch_record",
        "observation_record", "closure_record",
        "spawn_retry_count", "recovery_count",
        "updated_at"
      ],
      "properties": {
        "managed": false,
        "task_id": false,
        "attempt": false,
        "task_ref": {"$ref": "#/$defs/task_ref"},
        "task_name": {
          "anyOf": [
            {"$ref": "#/$defs/task_name"},
            {"type": "null"}
          ]
        },
        "resolved_mode": {"$ref": "#/$defs/resolved_mode"},
        "contract_summary": {"$ref": "#/$defs/contract_summary"},
        "contract_digest": {"$ref": "#/$defs/sha256"},
        "dispatch_record": {"$ref": "#/$defs/dispatch_record"},
        "observation_record": {"$ref": "#/$defs/observation_record"},
        "closure_record": {"$ref": "#/$defs/closure_record"},
        "execution_status": false,
        "spawn_observation": false,
        "identity_status": false,
        "platform_observation": false,
        "recovery_status": false,
        "parent_action": false,
        "spawn_retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "recovery_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "spawn_tool_use_id": false,
        "spawn_claimed_at": false,
        "spawn_post_observed_at": false,
        "spawn_observed_agent_id": false,
        "spawn_observed_canonical_path": false,
        "spawn_result_credential_id": false,
        "agent_id": false,
        "canonical_task_path": false,
        "pending_action": {"$ref": "#/$defs/pending_action"},
        "last_lifecycle_operation": {"$ref": "#/$defs/lifecycle_operation"},
        "parent_disposition_record": false,
        "attempt_closed": false,
        "attempt_close_reason": false,
        "attempt_closed_at": false,
        "created_at": false,
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "activity_at": false,
        "terminal_reconciliation_reason": false,
        "terminal_reconciled_at": false,
        "reconciliation_reason": false,
        "reconciled_thread_id": false,
        "reconciled_thread_status": false,
        "spawn_close_reason": false,
        "platform_checked_at": false,
        "platform_observation_source": false,
        "platform_observation_summary": false,
        "platform_observation_target": false,
        "start_observed_at": false,
        "parent_disposition": false,
        "parent_disposition_reason": false,
        "parent_disposition_at": false,
        "spawn_not_created": false,
        "initial_preparation_rollback": {"$ref": "#/$defs/initial_rollback_marker"}
      },
      "additionalProperties": false
    },
    "pending_action": {
      "type": "object",
      "required": [
        "target", "attempt", "task_ref", "operation_type", "phase",
        "created_at", "tool_use_id", "claimed_at"
      ],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "task_ref": {"$ref": "#/$defs/task_ref"},
        "operation_type": {"$ref": "#/$defs/pending_operation_type"},
        "phase": {"$ref": "#/$defs/pending_action_phase"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": false,
        "tool_use_id": {"type": ["string", "null"], "minLength": 1},
        "claimed_at": {"$ref": "#/$defs/nullable_timestamp"},
        "authorized_recovery": {"type": "boolean"},
        "result_credential_id": false,
        "resume_contract": {"$ref": "#/$defs/task_contract"},
        "resume_contract_digest": {"$ref": "#/$defs/sha256"},
        "resume_context_verification": {"$ref": "#/$defs/context_verification"},
        "prepared_on_attempt": {"$ref": "#/$defs/attempt"},
        "disposition": false
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["phase"],
            "properties": {"phase": {"const": "claimed"}}
          },
          "then": {
            "required": ["tool_use_id", "claimed_at"],
            "properties": {
              "tool_use_id": {"type": "string", "minLength": 1},
              "claimed_at": {"$ref": "#/$defs/timestamp"}
            }
          }
        },
        {
          "if": {
            "required": ["operation_type"],
            "properties": {"operation_type": {"const": "business_resume"}}
          },
          "then": {
            "required": [
              "resume_contract", "resume_contract_digest",
              "resume_context_verification", "prepared_on_attempt"
            ]
          }
        }
      ]
    },
    "lifecycle_operation": {
      "type": "object",
      "required": [
        "operation_type", "tool_use_id", "call_observation"
      ],
      "properties": {
        "operation_type": {"$ref": "#/$defs/lifecycle_operation_type"},
        "target": false,
        "tool_use_id": {"type": "string", "minLength": 1},
        "call_observation": {"$ref": "#/$defs/call_observation"},
        "target_observation": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "tombstone_record": {
      "type": "object",
      "required": ["task_ref", "dispatch_target", "close_reason", "closed_at"],
      "properties": {
        "task_ref": {"$ref": "#/$defs/task_ref"},
        "dispatch_target": {"type": ["string", "null"], "minLength": 1},
        "close_reason": {"$ref": "#/$defs/short_text"},
        "closed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "agent_identity_mapping": {
      "type": "object",
      "required": ["task_id", "attempt"],
      "properties": {
        "task_id": {"$ref": "#/$defs/task_id"},
        "attempt": {"$ref": "#/$defs/attempt"}
      },
      "additionalProperties": false
    },
    "prepared_native_parameters": {
      "type": "object",
      "required": ["task_name", "fork_turns", "model", "reasoning_effort"],
      "properties": {
        "task_name": {"$ref": "#/$defs/task_name"},
        "fork_turns": {"type": "string", "minLength": 1},
        "model": {"$ref": "#/$defs/model"},
        "reasoning_effort": {"$ref": "#/$defs/nullable_reasoning_effort"}
      },
      "additionalProperties": false
    },
    "prepared_contract": {
      "type": "object",
      "required": [
        "session_id", "task_id", "attempt", "task_ref", "task_name", "resolved_mode",
        "contract", "contract_digest", "context_verification", "native_parameters",
        "created_at", "consumed", "tool_use_id", "claimed_at", "post_observed_at",
        "spawn_retry_count", "dispatch_operation"
      ],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "task_id": {"$ref": "#/$defs/task_id"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "task_ref": {"$ref": "#/$defs/task_ref"},
        "task_name": {"$ref": "#/$defs/task_name"},
        "resolved_mode": {"$ref": "#/$defs/resolved_mode"},
        "contract": {"$ref": "#/$defs/task_contract"},
        "contract_digest": {"$ref": "#/$defs/sha256"},
        "context_verification": {"$ref": "#/$defs/context_verification"},
