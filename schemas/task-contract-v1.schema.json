{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subagent-governance/task-contract",
  "type": "object",
  "required": [
    "semantic_name",
    "requested_mode",
    "resolved_mode",
    "resolution_reason",
    "objective",
    "background",
    "work_scope",
    "forbidden_scope",
    "completion_conditions",
    "evidence_requirements",
    "relevant_files",
    "current_state",
    "context_strategy",
    "context_turns",
    "context_reason"
  ],
  "properties": {
    "semantic_name": {"$ref": "governance-semantics.schema.json#/$defs/semantic_name"},
    "requested_mode": {"$ref": "governance-semantics.schema.json#/$defs/requested_mode"},
    "resolved_mode": {"$ref": "governance-semantics.schema.json#/$defs/resolved_mode"},
    "resolution_reason": {"$ref": "governance-semantics.schema.json#/$defs/resolution_reason"},
    "task_features": {
      "anyOf": [
        {"$ref": "governance-semantics.schema.json#/$defs/task_features"},
        {"type": "null"}
      ]
    },
    "objective": {"$ref": "governance-semantics.schema.json#/$defs/business_text"},
    "background": {"$ref": "governance-semantics.schema.json#/$defs/business_text"},
    "work_scope": {"$ref": "governance-semantics.schema.json#/$defs/text_list", "minItems": 1},
    "forbidden_scope": {"$ref": "governance-semantics.schema.json#/$defs/text_list"},
    "completion_conditions": {"$ref": "governance-semantics.schema.json#/$defs/text_list", "minItems": 1},
    "evidence_requirements": {"$ref": "governance-semantics.schema.json#/$defs/text_list"},
    "relevant_files": {"$ref": "governance-semantics.schema.json#/$defs/text_list"},
    "current_state": {"$ref": "governance-semantics.schema.json#/$defs/nullable_business_text"},
    "model": {"$ref": "governance-semantics.schema.json#/$defs/model"},
    "reasoning_effort": {"$ref": "governance-semantics.schema.json#/$defs/nullable_reasoning_effort"},
    "context_strategy": {"$ref": "governance-semantics.schema.json#/$defs/context_strategy"},
    "context_turns": {"$ref": "governance-semantics.schema.json#/$defs/context_turns"},
    "context_reason": {"$ref": "governance-semantics.schema.json#/$defs/nullable_business_text"}
  },
  "allOf": [
    {
      "if": {"properties": {"requested_mode": {"const": "auto"}}},
      "then": {"required": ["task_features"], "properties": {"task_features": {"type": "object"}}}
    },
    {
      "if": {"properties": {"requested_mode": {"const": "light"}}},
      "then": {
        "properties": {
          "resolved_mode": {"const": "light"},
          "resolution_reason": {"const": "explicit_request"}
        }
      }
    },
    {
      "if": {"properties": {"requested_mode": {"const": "standard"}}},
      "then": {
        "properties": {
          "resolved_mode": {"const": "standard"},
          "resolution_reason": {"const": "explicit_request"}
        }
      }
    },
    {
      "if": {"properties": {"requested_mode": {"const": "strict"}}},
      "then": {
        "properties": {
          "resolved_mode": {"const": "strict"},
          "resolution_reason": {"const": "explicit_request"}
        }
      }
    },
    {
      "if": {"properties": {"resolved_mode": {"const": "standard"}}},
      "then": {"properties": {"evidence_requirements": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"resolved_mode": {"const": "strict"}}},
      "then": {
        "properties": {
          "forbidden_scope": {"minItems": 1},
          "evidence_requirements": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"context_strategy": {"const": "isolated"}}},
      "then": {"properties": {"context_turns": {"type": "null"}}}
    },
    {
      "if": {"properties": {"context_strategy": {"const": "limited"}}},
      "then": {
        "properties": {
          "context_turns": {"type": "integer", "minimum": 1, "maximum": 100},
          "context_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"context_strategy": {"const": "full"}}},
      "then": {
        "properties": {
          "context_turns": {"type": "null"},
          "context_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
