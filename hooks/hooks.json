{
  "description": "Adaptive lifecycle governance for Codex subagents.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(^Agent$|.*spawn_agent$|.*send_message$|.*followup_task$|.*interrupt_agent$)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 10,
            "statusMessage": "检查子 Agent 派发与通信"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 10,
            "statusMessage": "记录子 Agent 生命周期"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 10,
            "statusMessage": "恢复子 Agent 治理状态",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 3,
            "statusMessage": "清理子 Agent 治理状态"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 10,
            "statusMessage": "检查未完成的子 Agent"
          }
        ]
      }
    ]
  }
}
