{
  "description": "Minimal current-only lifecycle governance for Codex native subagents.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:spawn_agent|multi_agent_v1(?:\\.|__)?spawn_agent|collaboration\\.spawn_agent|collaborationspawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 10,
            "statusMessage": "检查 governed 子 Agent 派发"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 3,
            "statusMessage": "读取 exact Session 治理摘要",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/subagent_governance.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\subagent_governance.py\"",
            "timeout": 3,
            "statusMessage": "注入子 Agent 治理身份",
            "additionalContextLimit": 1800
          }
        ]
      }
    ]
  }
}
